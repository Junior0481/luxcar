-- Atores:
--   anon                      sem sessão
--   vendedor A  (SA)          loja A
--   vendedor A2 (SA2)         loja A (colega, para testar "vendedor vê só o seu")
--   admin A     (AA)          loja A
--   vendedor B  (SB)          loja B

create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;

-- Fixtures sem disparar triggers (handle_new_user, guard de profiles).
set local session_replication_role = replica;

