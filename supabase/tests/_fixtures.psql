set local session_replication_role = origin;

-- Conta linhas visíveis ao papel atual; falta de privilégio conta como 0 linhas.
create schema if not exists rls_test;
create or replace function rls_test.visible(q text) returns int
language plpgsql as $$
declare n int;
begin
  execute format('select count(*) from (%s) s', q) into n;
  return n;
exception when insufficient_privilege then
  return 0;
end $$;
grant usage on schema rls_test to anon, authenticated;
grant execute on function rls_test.visible(text) to anon, authenticated;

-- Troca de ator. Uso: :as_anon / :as_seller_a / ... / :as_postgres
\set as_postgres 'reset role; do $$ begin perform set_config(''request.jwt.claims'', '''', true); end $$;'
\set as_anon 'reset role; do $$ begin perform set_config(''request.jwt.claims'', ''{"role":"anon"}'', true); end $$; set local role anon;'
\set as_seller_a 'reset role; do $$ begin perform set_config(''request.jwt.claims'', ''{"sub":"a0000000-0000-0000-0000-0000000000a1","role":"authenticated"}'', true); end $$; set local role authenticated;'
\set as_seller_a2 'reset role; do $$ begin perform set_config(''request.jwt.claims'', ''{"sub":"a0000000-0000-0000-0000-0000000000a2","role":"authenticated"}'', true); end $$; set local role authenticated;'
\set as_admin_a 'reset role; do $$ begin perform set_config(''request.jwt.claims'', ''{"sub":"a0000000-0000-0000-0000-0000000000ad","role":"authenticated"}'', true); end $$; set local role authenticated;'
\set as_seller_b 'reset role; do $$ begin perform set_config(''request.jwt.claims'', ''{"sub":"b0000000-0000-0000-0000-0000000000b1","role":"authenticated"}'', true); end $$; set local role authenticated;'
